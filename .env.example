# Строка подключения к PostgreSQL
# При запуске через docker-compose хост = "db" (имя сервиса)
# При запуске без Docker используйте localhost
DATABASE_URL=postgresql://postgres:YOURPASSWORD@db:5432/handwriting_check

# Ключ OpenAI API (получить на https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Случайная строка для подписи сессий Flask (любой длинный случайный текст)
SECRET_KEY=replace-with-a-long-random-secret

# Пароль для PostgreSQL-контейнера - должен совпадать с паролем в DATABASE_URL
POSTGRES_PASSWORD=YOURPASSWORD
